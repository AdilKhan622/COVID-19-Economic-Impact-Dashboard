# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda / environment management
.conda/
.env
.env.*

# Jupyter / notebook checkpoints
.ipynb_checkpoints/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Local editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Raw data is reproducible via covid-economic-dashboard/scripts/download_data.sh
# (OWID's compact.csv alone is ~175MB, over GitHub's 100MB limit) — keep it out of git.
# data/processed/ is NOT ignored: those files are a real deliverable, meant to be
# committed so teammates/graders can see results without re-running the pipeline.
data/raw/
*.parquet
*.sqlite
*.db

# Streamlit / app runtime artifacts
.streamlit/
.python-version

# Logs
*.log

# Temporary files
tmp/
temp/

# Local secrets/config
secrets.json
config.local.*
